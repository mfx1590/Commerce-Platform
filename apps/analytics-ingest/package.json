{
  "name": "@platform/analytics-ingest",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "node dist/main.js",
    "once": "node dist/main.js --once",
    "ch:migrate": "tsx src/migrate-cli.ts",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint . --max-warnings 0",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@platform/test-utils": "workspace:*",
    "@types/node": "^20.19.0",
    "tsx": "4.23.13",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@clickhouse/client": "1.24.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@platform/events": "workspace:*",
    "kafkajs": "2.2.4"
  },
  "description": "ClickHouse ingest: every bus topic into raw_events, exactly once in effect (#600)"
}
