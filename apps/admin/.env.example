# @platform/admin — local overrides. Every value below is also the built-in default
# (see src/lib/env.ts), so `pnpm --filter @platform/admin dev` works with no .env at all.
# Copy to .env.local only when you need to point somewhere else.

# Keycloak staff realm. 8180 because 8080 is taken by other projects on dev machines.
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM_STAFF=staff

# Public OIDC client from infra/keycloak/staff-realm.json (PKCE, no secret).
ADMIN_OIDC_CLIENT_ID=admin-app

# Public origin of this app; the OIDC redirect URI is <ADMIN_APP_URL>/api/auth/callback
# and must stay in the client's registered redirect URIs.
ADMIN_APP_URL=http://localhost:3000

# Admin API. Phase 1 talks to the Prism mock started by `pnpm mock`.
MOCK_ADMIN_API_URL=http://localhost:4011

# Encrypts the session cookie. Required in production (>= 32 chars); a fixed
# development value is used when this is unset so restarts do not sign you out.
# ADMIN_SESSION_SECRET=
