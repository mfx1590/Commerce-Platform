{
  "name": "@platform/accounting",
  "version": "0.6.3",
  "private": true,
  "type": "module",
  "description": "Ledger service: consumes the five ledger events from the bus (group accounting.ledger) and writes balanced double-entry journal entries per legal entity (#548)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "node dist/main.js",
    "once": "node dist/main.js --once",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint . --max-warnings 0",
    "clean": "rm -rf dist .turbo",
    "reconcile": "node dist/reconcile/cli.js",
    "fixtures:payouts": "tsx src/reconcile/fixtures/write.ts",
    "erp:sync": "node dist/erp/cli.js",
    "odoo:init": "node dist/erp/odoo-init.js"
  },
  "dependencies": {
    "@platform/db": "workspace:*",
    "@platform/events": "workspace:*",
    "@platform/auth-sdk": "workspace:*",
    "yaml": "^2.9.0",
    "@platform/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsx": "^4.23.13",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1"
  }
}
