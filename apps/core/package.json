{
  "name": "@platform/core",
  "version": "0.1.0",
  "private": true,
  "description": "Medusa 2 commerce core (modular monolith) over the tenant-scoped schema in @platform/db",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "node .medusa/server/src/server.js",
    "build": "medusa build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:medusa:migrate": "tsx scripts/db-medusa-migrate.ts",
    "db:medusa:grants": "tsx scripts/db-medusa-migrate.ts --grants-only",
    "outbox:relay": "tsx src/outbox/relay-cli.ts",
    "outbox:replay": "tsx src/outbox/replay-cli.ts",
    "clean": "rm -rf .medusa dist .turbo",
    "lint": "eslint . --max-warnings 0",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "catalog:republish": "tsx scripts/catalog-republish.ts"
  },
  "dependencies": {
    "@clickhouse/client": "1.24.1",
    "@medusajs/cli": "2.20.1",
    "@medusajs/draft-order": "2.20.1",
    "@medusajs/framework": "2.20.1",
    "@medusajs/medusa": "2.20.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace": "2.12.0",
    "@platform/ai": "workspace:*",
    "@platform/auth-sdk": "workspace:*",
    "@platform/contracts": "workspace:*",
    "@platform/db": "workspace:*",
    "@platform/events": "workspace:*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "express": "^4.22.2",
    "ioredis": "5.11.1",
    "pg": "^8.23.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@platform/accounting": "workspace:*",
    "@platform/analytics-ingest": "workspace:*",
    "@platform/test-utils": "workspace:*",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
