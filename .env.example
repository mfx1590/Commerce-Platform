# Copy to .env — never commit .env. All local defaults match infra/docker/docker-compose.yml.
DATABASE_URL=postgres://platform:platform@localhost:5433/platform
# Application role: subject to RLS. Migrations use DATABASE_URL (owner); apps use DATABASE_URL_APP.
DATABASE_URL_APP=postgres://platform_app:platform_app@localhost:5433/platform
REDIS_URL=redis://localhost:6381
KAFKA_BROKERS=localhost:19092
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM_STAFF=staff
KEYCLOAK_REALM_CUSTOMERS=customers
OPENFGA_API_URL=http://localhost:8081
# apps/core needs the store id for real staff tokens (pnpm --filter @platform/auth-sdk fga:seed prints it).
# Missing: production refuses to start; locally real tokens answer 503 until it is set (dev tokens keep working).
OPENFGA_STORE_ID=
# Optional: pin every check to one authorization model version (default: the store's latest).
OPENFGA_MODEL_ID=
MOCK_API_URL=http://localhost:4010
MOCK_ADMIN_API_URL=http://localhost:4011

# --- apps/core (Medusa 2) ---
PORT=9000
CORE_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
# Local only: accept `Authorization: Bearer dev:<keycloak_subject>` on the Admin API. Never set outside local dev.
# Real Keycloak staff tokens are always accepted (KEYCLOAK_URL / KEYCLOAK_REALM_STAFF + OPENFGA_* above).
CORE_DEV_TOKENS=1
# Integration 1, non-production only: every /store/* request the core does not implement itself is proxied
# verbatim to this base URL (the Prism Store API mock) instead of reaching Medusa. Refused in production.
# Integration 1 stand-in, explicit opt-in like CORE_DEV_TOKENS: BOTH variables, never in production (the core refuses to boot).
# CORE_STORE_API_FALLBACK=1
# CORE_STORE_API_FALLBACK_URL=http://localhost:4010
MEDUSA_DB_SCHEMA=medusa
MEDUSA_DB_OWNER_PASSWORD=medusa_owner
DATABASE_URL_MEDUSA_OWNER=postgres://medusa_owner:medusa_owner@localhost:5433/platform
JWT_SECRET=dev-only-jwt-secret
COOKIE_SECRET=dev-only-cookie-secret
STORE_CORS=http://localhost:3100
ADMIN_CORS=http://localhost:3000
AUTH_CORS=http://localhost:3000,http://localhost:3100

# --- apps/admin ---
ADMIN_SESSION_SECRET=dev-only-admin-session-secret-at-least-32-chars
# Admin API base URL; wins over MOCK_ADMIN_API_URL above.
# real core: http://localhost:9000; mock: http://localhost:4011
ADMIN_API_URL=http://localhost:4011

# --- apps/storefront-starter ---
STORE_API_URL=http://localhost:4010
STORE_PUBLISHABLE_KEY=pk_brand-a_dev_00000000000000000000

# --- observability (infra 2.5, `docker compose --profile observability`) ---
# Read-only Postgres role for the Grafana outbox-lag panel (migration 0110); dev default, rotate outside local.
POSTGRES_METRICS_PASSWORD=platform_metrics
# Sentry DSN per app; empty disables Sentry.
SENTRY_DSN=
