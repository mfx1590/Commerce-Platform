{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.commerce-platform.dev/events/order.completed/v1.json",
  "title": "order.completed v1",
  "description": "All items delivered or returned; order closed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["order_id", "display_id", "completed_at"],
  "properties": {
    "order_id": {
      "$ref": "https://schemas.commerce-platform.dev/events/common/v1.json#/$defs/uuid"
    },
    "display_id": {
      "type": "integer"
    },
    "completed_at": {
      "$ref": "https://schemas.commerce-platform.dev/events/common/v1.json#/$defs/timestamp"
    }
  }
}
