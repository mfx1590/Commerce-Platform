{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.commerce-platform.dev/events/store.updated/v1.json",
  "title": "store.updated v1",
  "description": "Store settings changed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "store_id",
    "code",
    "status",
    "changed_fields"
  ],
  "properties": {
    "store_id": {
      "$ref": "https://schemas.commerce-platform.dev/events/common/v1.json#/$defs/uuid"
    },
    "code": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "paused",
        "archived"
      ]
    },
    "changed_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
