{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.commerce-platform.dev/events/stock_item.mapped/v1.json",
  "title": "stock_item.mapped v1",
  "description": "A store's variant was mapped to a stock item (Admin `mapVariantToStockItem`); from now on the variant sells from that item's pool. Ids only. The envelope's `store_id` is the variant's store, `aggregate_type` is `stock_item`, `aggregate_id` the item the variant is mapped to now.",
  "type": "object",
  "additionalProperties": false,
  "required": ["stock_item_id", "previous_stock_item_id", "variant_id", "store_id"],
  "properties": {
    "stock_item_id": {
      "$ref": "https://schemas.commerce-platform.dev/events/common/v1.json#/$defs/uuid"
    },
    "previous_stock_item_id": {
      "$ref": "https://schemas.commerce-platform.dev/events/common/v1.json#/$defs/uuid"
    },
    "variant_id": {
      "$ref": "https://schemas.commerce-platform.dev/events/common/v1.json#/$defs/uuid"
    },
    "store_id": {
      "$ref": "https://schemas.commerce-platform.dev/events/common/v1.json#/$defs/uuid"
    }
  }
}
