{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.commerce-platform.dev/events/fulfillment.picking/v1.json",
  "title": "fulfillment.picking v1",
  "description": "Picking started for a shipment.",
  "type": "object",
  "additionalProperties": false,
  "required": ["shipment_id", "order_id", "warehouse_id", "items", "occurred_at"],
  "properties": {
    "shipment_id": {
      "$ref": "https://schemas.commerce-platform.dev/events/common/v1.json#/$defs/uuid"
    },
    "order_id": {
      "$ref": "https://schemas.commerce-platform.dev/events/common/v1.json#/$defs/uuid"
    },
    "warehouse_id": {
      "$ref": "https://schemas.commerce-platform.dev/events/common/v1.json#/$defs/uuid"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order_line_item_id", "quantity"],
        "properties": {
          "order_line_item_id": {
            "$ref": "https://schemas.commerce-platform.dev/events/common/v1.json#/$defs/uuid"
          },
          "quantity": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "occurred_at": {
      "$ref": "https://schemas.commerce-platform.dev/events/common/v1.json#/$defs/timestamp"
    }
  }
}
