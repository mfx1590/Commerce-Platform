{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.commerce-platform.dev/events/shipment.created/v1.json",
  "title": "shipment.created v1",
  "description": "A shipment was planned for part or all of an order.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "shipment_id",
    "order_id",
    "warehouse_id",
    "carrier",
    "service",
    "items",
    "destination_country",
    "currency"
  ],
  "properties": {
    "shipment_id": {
      "$ref": "https://schemas.commerce-platform.dev/events/common/v1.json#/$defs/uuid"
    },
    "order_id": {
      "$ref": "https://schemas.commerce-platform.dev/events/common/v1.json#/$defs/uuid"
    },
    "warehouse_id": {
      "$ref": "https://schemas.commerce-platform.dev/events/common/v1.json#/$defs/uuid"
    },
    "carrier": {
      "type": "string",
      "minLength": 1
    },
    "service": {
      "type": [
        "string",
        "null"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order_line_item_id",
          "quantity"
        ],
        "properties": {
          "order_line_item_id": {
            "$ref": "https://schemas.commerce-platform.dev/events/common/v1.json#/$defs/uuid"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "destination_country": {
      "$ref": "https://schemas.commerce-platform.dev/events/common/v1.json#/$defs/country"
    },
    "currency": {
      "$ref": "https://schemas.commerce-platform.dev/events/common/v1.json#/$defs/currency"
    }
  }
}
