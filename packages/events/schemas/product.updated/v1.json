{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.commerce-platform.dev/events/product.updated/v1.json",
  "title": "product.updated v1",
  "description": "A product or its variants changed (any status).",
  "type": "object",
  "additionalProperties": false,
  "required": ["product_id", "handle", "status", "changed_fields", "variants"],
  "properties": {
    "product_id": {
      "$ref": "https://schemas.commerce-platform.dev/events/common/v1.json#/$defs/uuid"
    },
    "handle": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["draft", "published", "archived"]
    },
    "changed_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["variant_id", "sku", "title"],
        "properties": {
          "variant_id": {
            "$ref": "https://schemas.commerce-platform.dev/events/common/v1.json#/$defs/uuid"
          },
          "sku": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
