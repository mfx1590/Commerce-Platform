{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.commerce-platform.dev/events/stock.moved/v2.json",
  "title": "stock.moved v2",
  "description": "Stock of a stock item changed in a warehouse (one stock_movement row of the shared pool). `sku` is the stock item's. `variant_id` and `store_id` are present together, and only when a store caused the movement (a sale, a return, a shipment release); both are absent for a pool movement no store caused (receipt, transfer, cycle count), whose envelope `store_id` is null.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stock_movement_id",
    "stock_item_id",
    "sku",
    "warehouse_id",
    "delta",
    "reason",
    "reference_type",
    "reference_id",
    "on_hand_after",
    "reserved_after"
  ],
  "dependentRequired": {
    "variant_id": ["store_id"],
    "store_id": ["variant_id"]
  },
  "properties": {
    "stock_movement_id": {
      "$ref": "https://schemas.commerce-platform.dev/events/common/v1.json#/$defs/uuid"
    },
    "stock_item_id": {
      "$ref": "https://schemas.commerce-platform.dev/events/common/v1.json#/$defs/uuid"
    },
    "sku": {
      "type": "string",
      "minLength": 1
    },
    "variant_id": {
      "$ref": "https://schemas.commerce-platform.dev/events/common/v1.json#/$defs/uuid"
    },
    "store_id": {
      "$ref": "https://schemas.commerce-platform.dev/events/common/v1.json#/$defs/uuid"
    },
    "warehouse_id": {
      "$ref": "https://schemas.commerce-platform.dev/events/common/v1.json#/$defs/uuid"
    },
    "delta": {
      "type": "integer"
    },
    "reason": {
      "type": "string",
      "enum": [
        "receipt",
        "sale",
        "return",
        "adjustment",
        "transfer_in",
        "transfer_out",
        "cycle_count"
      ]
    },
    "reference_type": {
      "type": ["string", "null"]
    },
    "reference_id": {
      "oneOf": [
        {
          "$ref": "https://schemas.commerce-platform.dev/events/common/v1.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "on_hand_after": {
      "type": "integer"
    },
    "reserved_after": {
      "type": "integer"
    }
  }
}
