{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.commerce-platform.dev/events/payment.authorized/v1.json",
  "title": "payment.authorized v1",
  "description": "PSP authorized the amount.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "payment_id",
    "order_id",
    "legal_entity_id",
    "provider",
    "provider_payment_id",
    "amount_minor",
    "currency",
    "authorized_at"
  ],
  "properties": {
    "payment_id": {
      "$ref": "https://schemas.commerce-platform.dev/events/common/v1.json#/$defs/uuid"
    },
    "order_id": {
      "$ref": "https://schemas.commerce-platform.dev/events/common/v1.json#/$defs/uuid"
    },
    "legal_entity_id": {
      "$ref": "https://schemas.commerce-platform.dev/events/common/v1.json#/$defs/uuid"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "provider_payment_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "amount_minor": {
      "$ref": "https://schemas.commerce-platform.dev/events/common/v1.json#/$defs/minor"
    },
    "currency": {
      "$ref": "https://schemas.commerce-platform.dev/events/common/v1.json#/$defs/currency"
    },
    "authorized_at": {
      "$ref": "https://schemas.commerce-platform.dev/events/common/v1.json#/$defs/timestamp"
    }
  }
}
