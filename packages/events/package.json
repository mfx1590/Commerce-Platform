{
  "name": "@platform/events",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "migrations"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "node scripts/generate.mjs && tsc -p tsconfig.json",
    "typecheck": "node scripts/generate.mjs && tsc -p tsconfig.json --noEmit",
    "test": "node scripts/generate.mjs && vitest run",
    "clean": "rm -rf dist .turbo src/generated",
    "topics:create": "pnpm run build && node ../../infra/redpanda/create-topics.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0",
    "kafkajs": "2.2.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "json-schema-to-typescript": "^15.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
