{
  "name": "@platform/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./store": { "types": "./dist/store.d.ts", "import": "./dist/store.js" },
    "./admin": { "types": "./dist/admin.d.ts", "import": "./dist/admin.js" }
  },
  "files": ["dist", "openapi"],
  "scripts": {
    "generate": "openapi-typescript openapi/store-api.yaml -o src/generated/store.ts && openapi-typescript openapi/admin-api.yaml -o src/generated/admin.ts",
    "build": "pnpm generate && tsc -p tsconfig.json",
    "typecheck": "pnpm generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude test/contract.test.ts",
    "test:contract": "vitest run test/contract.test.ts",
    "mock": "node scripts/mock.mjs",
    "clean": "rm -rf dist .turbo src/generated"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "^5.14.0",
    "@types/node": "^20.19.0",
    "openapi-typescript": "^7.8.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
