{
  "name": "@platform/auth-sdk",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p ../../apps/core/src/modules/hq-rbac/tsconfig.json",
    "test": "vitest run",
    "fga:seed": "tsx scripts/fga-seed.ts",
    "roles": "tsx scripts/roles.ts",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@openfga/sdk": "0.9.7",
    "@platform/contracts": "workspace:*",
    "@platform/db": "workspace:*",
    "jose": "^6.2.11"
  },
  "devDependencies": {
    "@openfga/syntax-transformer": "0.2.2",
    "@types/node": "^20.19.0",
    "tsx": "^4.23.13",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
