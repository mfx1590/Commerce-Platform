{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", ".env"],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", ".next/**", "!.next/cache/**"] },
    "typecheck": { "dependsOn": ["^build"], "outputs": [] },
    "test": { "dependsOn": ["^build"], "outputs": [], "env": ["DATABASE_URL", "DATABASE_URL_APP"] },
    "test:contract": { "dependsOn": ["^build"], "outputs": [] },
    "generate": { "outputs": ["src/generated/**"] },
    "dev": { "cache": false, "persistent": true },
    "mock": { "cache": false, "persistent": true }
  }
}
