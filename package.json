{
  "name": "commerce-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.11",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "turbo run build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:contract": "turbo run test:contract",
    "mock": "pnpm --filter @platform/contracts mock",
    "db:migrate": "pnpm --filter @platform/db migrate",
    "db:seed": "pnpm --filter @platform/db seed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ownership": "bash scripts/check-ownership.sh",
    "compose:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "compose:down": "docker compose -f infra/docker/docker-compose.yml down"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/node": "^20.19.0",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.6.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "overrides": {
      "proxy-addr@>=1.1.0 <2.0.8": "2.0.8",
      "@medusajs/telemetry>axios": "1.20.0",
      "@sendgrid/client>axios": "1.20.0",
      "follow-redirects@>=1.16.0 <1.16.2": "1.16.2",
      "@graphql-tools/utils@>=12.0.0 <12.0.2": "12.0.2",
      "brace-expansion@>=4.0.0 <5.0.11": "5.0.11",
      "@grpc/grpc-js@>=1.14.0 <1.14.5": "1.14.5",
      "body-parser@>=1.20.0 <1.20.9": "1.20.9",
      "compression@>=1.8.0 <1.8.2": "1.8.2",
      "multer@>=2.0.0 <2.5.0": "2.5.0",
      "vite@>=7.0.0 <7.3.7": "7.3.7"
    }
  }
}
