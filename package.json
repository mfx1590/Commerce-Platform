{
  "name": "commerce-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.11",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "turbo run build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:contract": "turbo run test:contract",
    "mock": "pnpm --filter @platform/contracts mock",
    "db:migrate": "pnpm --filter @platform/db migrate",
    "db:seed": "pnpm --filter @platform/db seed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ownership": "bash scripts/check-ownership.sh",
    "compose:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "compose:down": "docker compose -f infra/docker/docker-compose.yml down"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/node": "^20.19.0",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.6.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.0"
  }
}
