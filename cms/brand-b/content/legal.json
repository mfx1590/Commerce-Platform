    "lastReviewed": "2026-10-09",
    "body": {
      "_type": "richText",
      "content": [
        {
          "_type": "block",
          "_key": "priv-h",
          "style": "h2",
          "children": [
            {
              "_type": "span",
              "_key": "priv-h-span",
              "text": "What we hold, and why"
            }
          ]
        },
        {
          "_type": "block",
          "_key": "priv-1",
          "style": "normal",
          "children": [
            {
              "_type": "span",
              "_key": "priv-1-span",
              "text": "[[COMPANY_LEGAL_NAME]] is the controller for the personal data described here, under the UK GDPR and the Data Protection Act 2018."
            }
          ]
        },
        {
          "_type": "block",
          "_key": "priv-2",
          "style": "normal",
          "children": [
            {
              "_type": "span",
              "_key": "priv-2-span",
              "text": "We hold the name, delivery address, email address and order history needed to sell you something and to honour the law on records. Card details never reach our servers: payment is taken by our provider's hosted fields."
            }
          ]
        },
        {
          "_type": "block",
          "_key": "priv-3",
          "style": "normal",
          "children": [
            {
              "_type": "span",
              "_key": "priv-3-span",
              "text": "Orders are kept for [[ORDER_RETENTION_PERIOD]] to meet HMRC record keeping requirements, then deleted."
            }
          ]
        },
        {
          "_type": "block",
          "_key": "priv-4",
          "style": "normal",
          "children": [
            {
              "_type": "span",
              "_key": "priv-4-span",
              "text": "To see, correct or erase what we hold, write to [[PRIVACY_CONTACT_EMAIL]]. You can complain to the Information Commissioner's Office at ico.org.uk."
            }
          ]
        }
      ]
    },
    "seo": {
      "metaTitle": "Privacy notice — Stonecrop",
      "metaDescription": "Privacy notice for Stonecrop."
    }
