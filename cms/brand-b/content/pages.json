    },
    "hero": {
      "_type": "hero",
      "headline": "A small list, made properly",
      "subheadline": "Who we are and what we will not do.",
      "layout": "full-bleed",
      "image": {
        "_type": "image",
        "mediaSlot": "about-workshop"
      }
    },
    "blocks": [
      {
        "_type": "richText",
        "_key": "about-body",
        "content": [
          {
            "_type": "block",
            "_key": "about-h",
            "style": "h2",
            "children": [
              {
                "_type": "span",
                "_key": "about-h-span",
                "text": "Why the list is short"
              }
            ]
          },
          {
            "_type": "block",
            "_key": "about-p1",
            "style": "normal",
            "children": [
              {
                "_type": "span",
                "_key": "about-p1-span",
                "text": "Every extra style is another pattern, another fabric order and another thing to get wrong. We would rather make eleven things we can answer questions about."
              }
            ]
          },
          {
            "_type": "block",
            "_key": "about-p2",
            "style": "normal",
            "children": [
              {
                "_type": "span",
                "_key": "about-p2-span",
                "text": "We do not run sales. The price is the price we need to pay the workshop and keep the lights on, and discounting it in January would mean it was wrong in June."
              }
            ]
          }
        ]
      }
    ],
    "seo": {
      "metaTitle": "About — Stonecrop",
      "metaDescription": "A short list of everyday clothes, made in small runs in Britain.",
      "ogImage": {
        "_type": "image",
        "mediaSlot": "og-default"
      }
    }
  },
