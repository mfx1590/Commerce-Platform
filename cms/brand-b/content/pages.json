            "_type": "block",
            "_key": "made-p2",
            "style": "normal",
            "children": [
              {
                "_type": "span",
                "_key": "made-p2-span",
                "text": "We publish the mill and the workshop because a supply chain you cannot name is one you cannot check."
              }
