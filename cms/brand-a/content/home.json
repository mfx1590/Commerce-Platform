            "_type": "block",
            "_key": "tee-p",
            "style": "normal",
            "children": [
              {
                "_type": "span",
                "_key": "tee-p-span",
                "text": "Bio-Baumwolle, in Portugal gestrickt, in einem Gewicht, das seine Form hält. Seit 2022 haben wir zweimal den Halsausschnitt geändert — sonst nichts."
              }
            ]
          }
