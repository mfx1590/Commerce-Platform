          "href": "/pages/cloth",
          "variant": "secondary"
        }
      ],
      "image": {
        "_type": "image",
        "mediaSlot": "home-hero-01"
      }
    },
    "blocks": [
      {
        "_type": "richText",
        "_key": "block-intro",
        "content": [
          {
            "_type": "block",
            "_key": "intro-h",
            "style": "h2",
            "children": [
              {
                "_type": "span",
                "_key": "intro-h-span",
                "text": "Fewer, better, slower"
              }
            ]
          },
          {
            "_type": "block",
            "_key": "intro-p1",
            "style": "normal",
            "children": [
              {
                "_type": "span",
                "_key": "intro-p1-span",
                "text": "We put out two collections a year and keep most pieces in the range for as long as the cloth is available. That means we can order fabric in quantities a mill takes seriously, and it means a jacket you bought two years ago can still be repaired with the same thread."
              }
            ]
          },
          {
            "_type": "block",
            "_key": "intro-p2",
            "style": "normal",
            "children": [
              {
                "_type": "span",
                "_key": "intro-p2-span",
                "text": "Everything ships from our own warehouse in the Netherlands. Returns are free across the EU for thirty days, and we will repair anything we made for as long as we can get the parts."
              }
            ]
          }
        ]
      },
      {
        "_type": "imageBlock",
        "_key": "img-home-hero-02",
        "image": {
          "_type": "image",
          "mediaSlot": "home-hero-02"
        },
        "width": "wide"
      },
      {
        "_type": "productStory",
        "_key": "block-tee",
        "productHandle": "classic-tee",
        "headline": "The Classic Tee, in its fourth year",
        "body": [
          {
            "_type": "block",
            "_key": "tee-p",
            "style": "normal",
            "children": [
              {
                "_type": "span",
                "_key": "tee-p-span",
                "text": "Organic cotton, knitted in Portugal at a weight that holds its shape. We have changed the neckline twice since 2022 and nothing else."
              }
            ]
          }
        ],
        "cta": {
          "_type": "cta",
          "_key": "tee-cta",
          "label": "See the Classic Tee",
          "href": "/products/classic-tee",
          "variant": "secondary"
