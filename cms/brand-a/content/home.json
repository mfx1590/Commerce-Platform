    "blocks": [
      {
        "_type": "richText",
        "_key": "block-intro",
        "content": [
          {
            "_type": "block",
            "_key": "intro-h",
            "style": "h2",
            "children": [
              {
                "_type": "span",
                "_key": "intro-h-span",
                "text": "Weniger, besser, langsamer"
