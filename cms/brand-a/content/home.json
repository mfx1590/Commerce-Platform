      "_type": "hero",
      "eyebrow": "Autumn 2026",
      "headline": "Clothes that get better with wearing",
      "subheadline": "A small range, made in short runs, in cloth we can name. Nothing here is designed to be replaced next season.",
      "layout": "image-right",
      "ctas": [
        {
          "_type": "cta",
