<!-- The read-only ClickHouse user for every query path (plan D4: the metrics API, BI Q&A and the recommendations job).
     The writer is the CLICKHOUSE_USER from the compose environment (the ingest and the migrations). Local word
     credentials, mirrored in .env.example; real ones come from the secrets manager at deploy. -->
<clickhouse>
    <profiles>
        <analytics_readonly>
            <readonly>1</readonly>
            <max_execution_time>10</max_execution_time>
            <max_result_rows>100000</max_result_rows>
            <result_overflow_mode>throw</result_overflow_mode>
            <max_memory_usage>536870912</max_memory_usage>
        </analytics_readonly>
    </profiles>
    <users>
        <analytics_ro>
            <password>analytics_ro</password>
            <profile>analytics_readonly</profile>
            <quota>default</quota>
            <networks>
                <ip>::/0</ip>
            </networks>
            <grants>
                <query>GRANT SELECT ON analytics.*</query>
            </grants>
        </analytics_ro>
    </users>
</clickhouse>
