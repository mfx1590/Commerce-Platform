  "attributes": {
    "_comment": "Customers realm (window 2, Phase 1; window 13 adds passwordless + per-brand theming). One public PKCE client per brand storefront; each client stamps store_code into the token. Social login (Google) is a disabled placeholder until GOOGLE_CLIENT_ID/SECRET exist. Dev-only settings are listed in infra/keycloak/README.md.",
    "frontendUrl": "http://localhost:8180"
