# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored — it names your account's
# domain and bucket prefix. It must never contain a password or a key: every secret in this stack
# is generated by Terraform and stored in Secrets Manager.
region        = "eu-central-1"
azs           = ["eu-central-1a", "eu-central-1b", "eu-central-1c"]
base_domain   = "example.com"
bucket_prefix = "acme"

github_repository           = "mfx1590/Commerce-Platform"
create_github_oidc_provider = false # dev already created it if both envs share an account

# Redpanda Cloud (managed-first decision): create the cluster in their console, paste the values here.
kafka_brokers       = ""
schema_registry_url = ""

# Narrow this once the office/VPN ranges are known.
cluster_public_access_cidrs = ["0.0.0.0/0"]
