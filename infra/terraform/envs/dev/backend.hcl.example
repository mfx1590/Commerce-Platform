# Copy to backend.hcl and fill in. backend.hcl is gitignored by name in
# infra/terraform/.gitignore — the *.tfvars rules do NOT cover it.
#
#   terraform init -backend-config=backend.hcl
#
# The bucket and lock table are created once per AWS account by the bootstrap step in the
# runbook (infra/README.md), before the first `terraform apply`.
bucket         = "REPLACE-tfstate"
key            = "commerce-platform/dev/terraform.tfstate"
region         = "eu-central-1"
dynamodb_table = "REPLACE-tfstate-lock"
encrypt        = true
